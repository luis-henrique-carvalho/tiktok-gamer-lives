# ==============================================================================
# TikTok Gamer Lives - Environment Configuration (Root Example)
# ==============================================================================

# Node Environment
NODE_ENV=development

# Backend API Service
PORT=3001
HOST=0.0.0.0
API_PORT=3001

# PostgreSQL Database (Pg 17)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tiktok_gamer_lives

# Redis Cache & BullMQ Queue
REDIS_URL=redis://localhost:6379

# Authentication & Security
BETTER_AUTH_SECRET=supersecret-dev-key-change-in-prod-min-32-chars
BETTER_AUTH_URL=http://localhost:3001

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5180

# Frontend Web Service
WEB_PORT=5180
VITE_PORT=5180
VITE_HOST=0.0.0.0
VITE_BACKEND_PROXY_TARGET=http://localhost:3001
VITE_API_URL=http://localhost:3001
VITE_AUTH_URL=http://localhost:3001
